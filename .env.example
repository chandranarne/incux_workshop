# ==============================================================================
# INCUX AI PLATFORM - CONSOLIDATED ENVIRONMENT CONFIGURATION
# ==============================================================================
# Single root .env file consumed by BOTH backend (Node/Express) and frontend (Vite).
# NOTE: Variables exposed to the browser client MUST start with the VITE_ prefix.

# --- BACKEND SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development

# --- FRONTEND CLIENT CONFIGURATION ---
VITE_API_BASE=http://localhost:5000/api

# --- SUPABASE CONFIGURATION (DATABASE & AUTH) ---
# Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://mpcxwgcjqyyfwtzdohfi.supabase.co
VITE_SUPABASE_URL=https://mpcxwgcjqyyfwtzdohfi.supabase.co

# Anon Public Key (Safe for frontend queries with Row Level Security)
SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Service Role Key (Backend ONLY - Keep secret, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
